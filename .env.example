# AC Custom Labs - Public and Server Environment Variables Template
# Copy this file to .env.local for local development. Never commit real secrets.

# Canonical site URL (used for SEO metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://accustomlabs.com

# Analytics ID (Optional / Post-launch)
NEXT_PUBLIC_ANALYTICS_ID=

# Contact & Lead Notification Configuration (Server-side only)
CONTACT_NOTIFICATION_EMAIL=
EMAIL_SERVICE_API_KEY=
CRM_WEBHOOK_URL=
